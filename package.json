{
  "scripts": {
    "dev:frontend": "vite frontend --host 0.0.0.0",
    "build": "vite frontend build",
    "preview": "vite preview frontend --host 0.0.0.0",
    "dev:backend": "cross-env port=5174 VERBOSE=true node ./backend/server.js",
    "dev:aiserver": "cd ai_server && uvicorn server:app --reload --host 0.0.0.0 --port 5175",
