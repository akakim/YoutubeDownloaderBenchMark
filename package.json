{
  "scripts": {
    "dev:frontend": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "dev:backend": "cross-env VERBOSE=true node ./backend/server.js",
    "dev:aiserver": "cd ai_server && uvicorn server:app --reload --host 0.0.0.0 --port 8000",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:aiserver\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "openai": "^6.39.1",
    "react": "latest",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0",
    "vite": "latest"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  },
  "type": "module"
}
